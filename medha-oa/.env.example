# Copy to .env.local and adjust. Never commit .env.local.

# --- Offline AI assistant (Ollama, runs on this device) ---
# Any model you have pulled locally works; llama3 is what this was tested with.
OLLAMA_MODEL=llama3:latest
# OLLAMA_URL=http://localhost:11434

# --- X-ray KL model service (medha-oa/ml/server.py) ---
# Start it with: npm run ml:serve
MEDHA_ML_URL=http://127.0.0.1:8000
MEDHA_ML_TIMEOUT_MS=120000
# MEDHA_GRADCAM=0            # set to 0 to disable the Grad-CAM overlay
# MEDHA_DEPLOY_ROOT=C:\path\to\SANDHIQ_DEPLOY
# MEDHA_MODEL_PATH=C:\path\to\SANDHIQ_DEPLOY\model\medha_oa_kl_final.keras

# --- Sensor gateway (ml/server.py reads these) ---
# MEDHA_LAN_IP=192.168.1.50      # pin the address advertised to the IMU nodes
# MEDHA_IMU_THIGH_PORT=5005
# MEDHA_IMU_SHANK_PORT=5006
# MEDHA_IMU_REQUIRE_BOTH=0
# MEDHA_HX711_ENABLED=0          # 1 on Linux only, once a load cell is wired
# MEDHA_GRIP_SIM=0               # 0 disables the generated force-test source
